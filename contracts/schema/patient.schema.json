{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patient",
  "description": "Profilul pacientului și ancorele zilei (5.7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "birth_year",
    "caregiver_name",
    "anchors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pat_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "birth_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2026
    },
    "caregiver_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "numele aparținătorului, folosit în texte („Am anunțat-o pe Ana”)"
    },
    "anchors": {
      "$ref": "schedule.schema.json#/$defs/anchors"
    },
    "height_cm": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 230,
      "description": "înălțimea în centimetri; null = necompletată"
    },
    "weight_kg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 25,
      "maximum": 250,
      "description": "greutatea în kilograme; null = necompletată"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "uniqueItems": true,
      "maxItems": 30,
      "description": "afecțiunile alese din listă; etichetele în română sunt în fixtures/conditions.json"
    },
    "conditions_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "alte afecțiuni, scrise liber"
    }
  },
  "$defs": {
    "condition": {
      "type": "string",
      "description": "Afecțiunile din profilul pacientului (lista din aplicație și din portal). Deocamdată doar se arată; regulile boală–medicament vin după hackathon.",
      "enum": [
        "hypertension",
        "heart_failure",
        "atrial_fibrillation",
        "coronary_disease",
        "stroke",
        "high_cholesterol",
        "diabetes",
        "hypothyroidism",
        "chronic_kidney_disease",
        "liver_disease",
        "copd_asthma",
        "gastric_ulcer",
        "osteoporosis",
        "arthritis",
        "dementia",
        "parkinson",
        "depression",
        "epilepsy",
        "glaucoma",
        "prostate",
        "falls"
      ]
    }
  }
}
